meta {
  name: Criar curso
  type: http
  seq: 1
}

post {
  url: https://influencer-marketplace-api.onrender.com/curso
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "codigo_unico": "CURSO-{{sufixo}}",
    "titulo": "Marketing de influência na prática {{indice}}",
    "descricao": "Curso sobre campanhas digitais",
    "criador_id": "{{criadorId}}"
  }
}

script:post-response {
  if (res.body?.id) bru.setVar("cursoId", res.body.id);
}

tests {
  test("Curso criado", function () {
    expect(res.status).to.equal(201);
  });
}
