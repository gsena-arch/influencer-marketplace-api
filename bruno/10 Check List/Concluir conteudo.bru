meta {
  name: Concluir conteudo
  type: http
  seq: 1
}

post {
  url: https://influencer-marketplace-api.onrender.com/check_list
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "conteudo_id": "{{conteudoId}}",
    "matricula_id": "{{matriculaId}}",
    "status": true,
    "data_realizacao": "2026-11-24T16:00:00.000Z"
  }
}

script:post-response {
  if (res.body?.id) bru.setVar("checkListId", res.body.id);
}

tests {
  test("Checklist registrado", function () {
    expect(res.status).to.equal(201);
  });
}
