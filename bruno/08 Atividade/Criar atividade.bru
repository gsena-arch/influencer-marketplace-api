meta {
  name: Criar atividade
  type: http
  seq: 1
}

post {
  url: https://influencer-marketplace-api.onrender.com/atividade
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "modulo_id": "{{moduloId}}",
    "conteudo_id": "{{conteudoId}}",
    "titulo": "Defina uma persona {{indice}}",
    "descricao": "Crie a persona principal para uma campanha de influência.",
    "tipo": "prática"
  }
}

script:post-response {
  if (res.body?.id) bru.setVar("atividadeId", res.body.id);
}

tests {
  test("Atividade criada", function () {
    expect(res.status).to.equal(201);
  });
}
