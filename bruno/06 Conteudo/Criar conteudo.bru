meta {
  name: Criar conteudo
  type: http
  seq: 1
}

post {
  url: https://influencer-marketplace-api.onrender.com/conteudo
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "modulo_id": "{{moduloId}}",
    "titulo": "Como definir o público-alvo {{indice}}",
    "conteudo": "Identifique interesses, necessidades e canais utilizados pelo público."
  }
}

script:post-response {
  if (res.body?.id) bru.setVar("conteudoId", res.body.id);
}

tests {
  test("Conteúdo criado", function () {
    expect(res.status).to.equal(201);
  });
}
