meta {
  name: Criar Bruno
  type: http
  seq: 1
}

post {
  url: https://influencer-marketplace-api.onrender.com/usuario
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nome": "Bruno Silva {{indice}}",
    "email": "{{sufixo}}@example.com",
    "status": "ativo"
  }
}

script:post-response {
  if (res.body?.id) bru.setVar("usuarioId", res.body.id);
}

tests {
  test("Usuário criado", function () {
    expect(res.status).to.equal(201);
    expect(res.body.id).to.be.a("string");
  });
}
